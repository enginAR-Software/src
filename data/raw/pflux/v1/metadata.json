    {
      "name": "Intended use",
      "value": "The phosphorus budgets within this database are representative of cropping systems throughout the Long-Term Agroecosystem Research (LTAR) Network in the United States as well as non-LTAR sites, including Ontario and Manitoba, Canada. Data are intended to compare field-scale soil surface P fluxes and budgets across sites and cropping systems and identify gaps in P budgets across study sites.",
      "settings": {
        "validations": {
          "min_length": 3,
          "max_length": 2000
        },
        "placeholder": "Intended use"
      },
      "field_type": "textarea",
      "order": null,
      "is_mandatory": false
    },
    {
      "name": "Use limitations",
      "value": "Use of these datasets should be used to compare typical phosphorus budgets across cropping systems and sites throughout the United States and Canada. Use of the data should follow the LTAR Data Sharing Principles and Guidelines, which can be found at: https://ltar.ars.usda.gov/wp-content/uploads/2020/05/LTAR_DataSharing_PrincGuide_v1_0.pdf.",
